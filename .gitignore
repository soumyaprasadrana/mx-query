# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Internal-only — engineering/PM docs and agent instructions, never public.
# Only raw code and config are meant to leave this machine. Anchored with a
# leading slash: a bare "docs/" matches a directory named docs at ANY depth,
# which would also swallow docs-site/docs/ (the public docs site's own
# content folder, meant to be tracked) — not just this top-level one.
/docs/
/AGENTS.md
/NOTICE
/NOTICE.md

# Node / frontend
node_modules/
frontend/dist/
frontend/build/
.vite/
*.tsbuildinfo

# Docs site (VitePress) build output — regenerated by `npm run docs:build`
docs-site/docs/.vitepress/dist/
docs-site/docs/.vitepress/cache/
docs-site/docs/.vitepress/.temp/

# Env / secrets
.env
.env.*
!.env.example

# Tenant runtime data (per-tenant MCP data/logs dirs, never committed)
data/
*.data-dir/
logs/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
