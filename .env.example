# Copy to .env and fill in what you need. Every one of these has a working
# default for a quick local try — see README.md's env var table for the
# full reference. .env is gitignored; never commit a real one.

# AES-256-GCM key encrypting tenant Maximo API keys (and any admin-set LLM
# key) at rest. Blank falls back to a machine-local derived key — fine for
# a single-user local try, set this explicitly for anything shared/hosted.
MQB_SESSION_ENCRYPTION_KEY=

# Gates the admin-only LLM/theme Settings screen. Leave blank to disable
# that screen entirely (no login surface at all, not a weak password).
MQB_ADMIN_PASSWORD=

# Deploy-time default AI provider for the wizard's optional Assist feature
# (litellm — any provider works). An admin can override this at runtime
# from Settings without touching these env vars.
MQB_LLM_MODEL=ollama/qwen2.5:1.5b
MQB_LLM_API_KEY=
MQB_LLM_API_BASE=http://127.0.0.1:11434
